# Shared secret the Android app sends as `Authorization: Bearer <APP_API_SECRET>`
APP_API_SECRET=

# Groq (voice transcription, whisper-large-v3)
GROQ_API_KEY=

# Serper.dev (LinkedIn URL + avatar via /images + company domain via knowledge graph)
SERPER_API_KEY=

# OpenRouter (note summary). Model is overridable; defaults to moonshotai/kimi-k2.6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2.6

# Gemini (deferred: grounded work-email discovery; unused until lib/gemini.ts is implemented)
GEMINI_API_KEY=

# Twenty CRM REST API
TWENTY_API_KEY=
TWENTY_BASE_URL=https://crm.luiskisters.com

# Google People API (one-time refresh token; see `npm run google-auth`)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
